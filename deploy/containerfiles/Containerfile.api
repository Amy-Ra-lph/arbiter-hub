# deploy/containerfiles/Containerfile.api
FROM registry.redhat.io/ubi10/python-312 AS builder
WORKDIR /opt/app-root/src
COPY pyproject.toml .
COPY server/ server/
RUN pip install --no-cache-dir .

# Fallback: UBI10-minimal until RHHI Python micro is available
# Target: registry.redhat.io/rhhi/python-312-micro
FROM registry.redhat.io/ubi10/ubi-minimal
RUN microdnf install -y python3.12 && microdnf clean all
COPY --from=builder /opt/app-root /opt/app-root
ENV PATH="/opt/app-root/bin:$PATH"
USER 1001
EXPOSE 8400
CMD ["python3.12", "-m", "uvicorn", "server.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8400"]
