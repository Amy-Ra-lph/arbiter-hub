# deploy/containerfiles/Containerfile.api
FROM registry.redhat.io/ubi10/python-312-minimal

# krb5-devel needed to build gssapi wheel for SPNEGO auth
USER 0
RUN microdnf -y install krb5-workstation krb5-devel gcc && microdnf clean all
USER 1001

WORKDIR /opt/app-root/src
COPY pyproject.toml .
COPY server/ server/
COPY alembic/ alembic/
COPY alembic.ini .
RUN pip install --no-cache-dir ".[spnego]"
EXPOSE 8400
CMD ["python3.12", "-m", "uvicorn", "server.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8400"]
