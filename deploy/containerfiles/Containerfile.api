# deploy/containerfiles/Containerfile.api
FROM registry.redhat.io/ubi10/python-312-minimal
WORKDIR /opt/app-root/src
COPY pyproject.toml .
COPY server/ server/
COPY alembic/ alembic/
COPY alembic.ini .
RUN pip install --no-cache-dir .
USER 1001
EXPOSE 8400
CMD ["python3.12", "-m", "uvicorn", "server.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8400"]
