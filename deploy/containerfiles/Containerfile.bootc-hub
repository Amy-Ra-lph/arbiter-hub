# Arbiter Hub node — bootc image
# Podman + quadlet containers (db/api/ui/mcp) + host nginx TLS + EDA controller
#
# Build:
#   podman build -t quay.io/rhel-security/arbiter-hub-hub:latest \
#     -f deploy/containerfiles/Containerfile.bootc-hub .
#
# Config: inject /etc/arbiter-hub/config.env via cloud-init userdata
# Firstboot: enrolls IPA client, deploys quadlet units, starts nginx+EDA
FROM quay.io/fedora/fedora-bootc:44

# Layer 1: Container runtime + nginx
RUN dnf -y install \
        podman \
        nginx \
        openssh-server \
        cloud-init \
        qemu-guest-agent \
        certmonger \
        ipa-client \
    && dnf clean all \
    && systemctl enable sshd

# Layer 2: EDA controller dependencies
# ansible-rulebook needs Java for Drools rule engine
RUN dnf -y install \
        python3-pip \
        python3-devel \
        java-25-openjdk-headless \
        gcc \
    && pip install --no-cache-dir \
        ansible-core \
        ansible-rulebook \
        aiohttp \
        ansible-runner \
    && dnf clean all

# Layer 3: Quadlet container unit files (baked in, env-specific config via drop-ins)
RUN mkdir -p /etc/containers/systemd \
             /etc/arbiter \
             /etc/arbiter-hub
COPY deploy/quadlet/*.container /etc/containers/systemd/
COPY deploy/quadlet/*.network /etc/containers/systemd/ 2>/dev/null || true

# Layer 4: nginx config template (TLS termination pattern)
# Actual certs from certmonger via firstboot after IPA client enrollment
COPY deploy/nginx/arbiter-hub.conf.template /etc/nginx/conf.d/arbiter-hub.conf.template

# Layer 5: EDA source plugin + rulebooks + remediation playbooks (baked in)
RUN mkdir -p /opt/arbiter-eda/plugins/event_source \
             /opt/arbiter-eda/rulebooks \
             /opt/arbiter-eda/playbooks \
             /opt/arbiter-eda/inventory
COPY eda/plugins/event_source/ /opt/arbiter-eda/plugins/event_source/
COPY eda/rulebooks/ /opt/arbiter-eda/rulebooks/
COPY eda/playbooks/ /opt/arbiter-eda/playbooks/

# SELinux boolean for nginx → container proxy
RUN setsebool -P httpd_can_network_connect on 2>/dev/null || true

# Firstboot: IPA client enroll → certmonger cert → nginx config → start containers
COPY deploy/bootc/hub-firstboot.sh /usr/local/sbin/arbiter-hub-firstboot
COPY deploy/bootc/hub-firstboot.service /etc/systemd/system/arbiter-hub-firstboot.service
RUN chmod 755 /usr/local/sbin/arbiter-hub-firstboot

# EDA systemd unit (template — secret injected by firstboot)
COPY deploy/bootc/arbiter-eda.service.template /etc/arbiter-hub/arbiter-eda.service.template

# Fedora bootc gaps
RUN mkdir -p /usr/local/sbin /etc/cloud/cloud.cfg.d \
    && printf '%s\n' \
       'system_info:' \
       '  default_user:' \
       '    name: cloud-user' \
       '    lock_passwd: false' \
       '    groups: [wheel]' \
       '    sudo: ["ALL=(ALL) NOPASSWD:ALL"]' \
       '    shell: /bin/bash' \
       > /etc/cloud/cloud.cfg.d/10-cloud-user.cfg

RUN systemctl enable arbiter-hub-firstboot.service \
                      qemu-guest-agent.service \
                      cloud-init-local.service cloud-init.service \
                      cloud-config.service cloud-final.service \
    && systemctl disable firewalld.service || true
