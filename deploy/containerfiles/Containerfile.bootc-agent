# Arbiter Hub agent node — bootc image
# Falco eBPF + Keylime agent + demo workload containers + OpenShell gateway
#
# Build:
#   podman build -t quay.io/rhel-security/arbiter-hub-agent:latest \
#     -f deploy/containerfiles/Containerfile.bootc-agent .
#
# Config: inject /etc/arbiter-hub/config.env via cloud-init userdata
# Firstboot: enrolls IPA client, starts Keylime agent, deploys workloads
FROM quay.io/fedora/fedora-bootc:44

# Layer 1: Base runtime
RUN dnf -y install \
        podman \
        openssh-server \
        cloud-init \
        qemu-guest-agent \
        ipa-client \
        python3-pip \
        python3-requests \
    && dnf clean all \
    && systemctl enable sshd

# Layer 2: Keylime agent
RUN dnf -y install \
        keylime-agent \
        tpm2-tss \
        tpm2-tools \
    && dnf clean all \
    && systemctl enable keylime_agent

# Layer 3: Falco eBPF
# Falco repo + modern eBPF driver (no kernel module needed on bootc)
RUN rpm --import https://falco.org/repo/falcosecurity-packages.asc \
    && curl -s -o /etc/yum.repos.d/falcosecurity.repo \
       https://falco.org/repo/falcosecurity-rpm.repo \
    && dnf -y install \
        falco \
        falcoctl \
    && dnf clean all \
    && systemctl enable falco-modern-bpf falcoctl-artifact-follow

# Layer 4: Demo agent scripts + honeypot canaries (baked in image)
RUN mkdir -p /opt/demo/agents /opt/demo/output
COPY demo/agents/governed_agent.py /opt/demo/agents/
COPY demo/agents/rogue_agent.py /opt/demo/agents/
RUN chmod 755 /opt/demo/agents/*.py

# Layer 5: Honeypot canaries — fake credentials for Falco to detect access
RUN mkdir -p /root/.aws /root/.kube \
    && printf '%s\n' \
       '[default]' \
       'aws_access_key_id = AKIADEMOCANARY00001' \
       'aws_secret_access_key = DEMO-CANARY-DO-NOT-USE-wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY' \
       'region = us-east-1' \
       > /root/.aws/credentials \
    && chmod 600 /root/.aws/credentials \
    && printf '%s\n' \
       'apiVersion: v1' \
       'kind: Config' \
       'clusters:' \
       '- cluster:' \
       '    server: https://demo-cluster.example.com:6443' \
       '    certificate-authority-data: DEMO-CANARY-DO-NOT-USE' \
       '  name: demo-canary' \
       'contexts:' \
       '- context:' \
       '    cluster: demo-canary' \
       '    user: demo-canary-admin' \
       '  name: demo-canary' \
       'current-context: demo-canary' \
       'users:' \
       '- name: demo-canary-admin' \
       '  user:' \
       '    token: DEMO-CANARY-DO-NOT-USE-eyJhbGciOiJSUzI1NiJ9' \
       > /root/.kube/config \
    && chmod 600 /root/.kube/config
# Canary SSH key generated at firstboot (needs entropy)

# Layer 6: OpenShell gateway binary + trust-tiered sandbox configs
RUN mkdir -p /opt/openshell /etc/openshell
COPY deploy/openshell/ /opt/openshell/ 2>/dev/null || true

# Firstboot: IPA client enroll → Keylime agent config → demo workloads → register with Hub
COPY deploy/bootc/agent-firstboot.sh /usr/local/sbin/arbiter-agent-firstboot
COPY deploy/bootc/agent-firstboot.service /etc/systemd/system/arbiter-agent-firstboot.service
RUN chmod 755 /usr/local/sbin/arbiter-agent-firstboot

# Rogue agent exfil URL patched at firstboot from config.env

# Fedora bootc gaps
RUN mkdir -p /usr/local/sbin /etc/cloud/cloud.cfg.d \
    && printf '%s\n' \
       'system_info:' \
       '  default_user:' \
       '    name: cloud-user' \
       '    lock_passwd: false' \
       '    groups: [wheel]' \
       '    sudo: ["ALL=(ALL) NOPASSWD:ALL"]' \
       '    shell: /bin/bash' \
       > /etc/cloud/cloud.cfg.d/10-cloud-user.cfg

RUN systemctl enable arbiter-agent-firstboot.service \
                      qemu-guest-agent.service \
                      cloud-init-local.service cloud-init.service \
                      cloud-config.service cloud-final.service \
    && systemctl disable firewalld.service || true
