# deploy/containerfiles/Containerfile.kbs
FROM registry.redhat.io/ubi10/python-312-minimal
WORKDIR /opt/app-root/src
COPY pyproject.toml .
COPY server/ server/
RUN pip install --no-cache-dir .
USER 1001
EXPOSE 8085
CMD ["python3.12", "-m", "uvicorn", "server.main:create_kbs_app", "--factory", "--host", "0.0.0.0", "--port", "8085"]
