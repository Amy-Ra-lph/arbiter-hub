# Arbiter Hub bootc config — inject via cloud-init write_files to /etc/arbiter-hub/config.env
# Each node type uses a subset of these variables.
# Required vars are marked (REQUIRED), optional have defaults shown.
#
# Auth cascade: Kerberos SPNEGO via IPA keytab (automatic after IPA enrollment) →
#               ARBITER_SERVICE_PASSWORD fallback (for non-IPA / external OAuth setups).
# SPNEGO requires no shared secrets. Password is the fallback only.

# ── Shared (all 4 nodes) ──
IPA_DOMAIN=demo.example.com                  # (REQUIRED) IPA DNS domain
IPA_ADMIN_PASSWORD=                          # (REQUIRED) IPA admin password

# ── IdM node only ──
IPA_REALM=DEMO.EXAMPLE.COM                  # (REQUIRED) Kerberos realm (usually uppercase domain)
IPA_DS_PASSWORD=                             # (REQUIRED) Directory Server manager password
IDM_HOSTNAME=idm.demo.example.com           # (optional) defaults to hostname -f
AHDAPA_INSTALL=                              # (optional) set non-empty to install ahdapa OIDC provider

# ── Attestation node (arbiter-attestation) — also runs SPIRE server ──
IDM_HOSTNAME=idm.demo.example.com           # (REQUIRED) IdM server for IPA client enrollment
HUB_HOSTNAME=hub.demo.example.com           # (optional) defaults to hostname -f
SIGNING_HOSTNAME=signing.demo.example.com   # (REQUIRED) Signing node for Keylime verifier URL
DB_PASSWORD=                                 # (REQUIRED) PostgreSQL password for arbiter-hub-db
WEBHOOK_SECRET=                              # (optional) auto-generated if empty
ARBITER_SERVICE_PASSWORD=                    # (optional) auto-generated if empty; password fallback for service auth
API_PORT=8400                                # (optional) Arbiter Hub API port
MCP_PORT=8401                                # (optional) MCP server port
UI_PORT=8402                                 # (optional) UI server port
EDA_PORT=5001                                # (optional) EDA webhook listener port
AGENT_HOSTNAME=agent.demo.example.com        # (optional) agent hostname for EDA inventory
AGENT_IP=                                    # (optional) agent IP for EDA inventory, defaults to 127.0.0.1

# ── Signing node (arbiter-signing) ──
IDM_HOSTNAME=idm.demo.example.com           # (REQUIRED) IdM server for IPA client enrollment
SIGNING_HOSTNAME=signing.demo.example.com   # (optional) defaults to hostname -f
HUB_HOSTNAME=hub.demo.example.com           # (REQUIRED) Attestation node to export certs to
COSIGN_PASSWORD=                             # (optional) passphrase for cosign keypair, empty for none
REGISTRY_PORT=5000                           # (optional) container registry port

# ── Agent node (arbiter-agent) — also runs SPIRE agent ──
IDM_HOSTNAME=idm.demo.example.com           # (REQUIRED) IdM server for IPA client enrollment
HUB_HOSTNAME=hub.demo.example.com           # (REQUIRED) Attestation node hostname (also SPIRE server)
HUB_API_URL=https://hub.demo.example.com    # (optional) full Hub API URL, defaults to https://${HUB_HOSTNAME}
SIGNING_HOSTNAME=signing.demo.example.com   # (REQUIRED) Signing node for Keylime registrar
ARBITER_SERVICE_PASSWORD=                    # (optional) same value as Hub; only needed if SPNEGO unavailable
AGENT_HOSTNAME=agent.demo.example.com        # (optional) defaults to hostname -f
SPIRE_JOIN_TOKEN=                            # (REQUIRED) generated by SPIRE server on attestation node
