# Arbiter Server config — inject via cloud-init write_files to /etc/arbiter/server.env
#
# Three required values. Everything else has sane defaults.

# ── Required ─────────────────────────────────────────────────────────
IPA_SERVER=idm.example.com               # Existing IdM server FQDN
IPA_DOMAIN=example.com                   # IPA domain
IPA_ADMIN_PASSWORD=                      # IPA admin password (redacted after enrollment)

# ── Optional ─────────────────────────────────────────────────────────
ARBITER_HOSTNAME=                        # defaults to $(hostname -f)
DB_PASSWORD=                             # auto-generated if empty
WEBHOOK_SECRET=                          # auto-generated if empty
ARBITER_SERVICE_PASSWORD=                # auto-generated if empty (password auth fallback)

# ── Backend toggles ──────────────────────────────────────────────────
KEYLIME_ENABLED=true                     # keylime-verifier + registrar
COSIGN_ENABLED=true                      # container image signature verification
EDA_ENABLED=true                         # Event-Driven Ansible remediation

# ── Ports ────────────────────────────────────────────────────────────
API_PORT=8400
UI_PORT=8080
EDA_PORT=5001

# ── Replication (multi-server only) ──────────────────────────────────
# ARBITER_SERVER_ID=                     # unique per server, defaults to hostname
# ARBITER_REPL_PEERS=                    # comma-separated peer:port list, or empty for DNS SRV discovery
# ARBITER_REPL_PORT=8410
