[Unit]
Description=Arbiter Server firstboot provisioning
After=network-online.target cloud-final.service
Wants=network-online.target
ConditionPathExists=!/var/lib/arbiter/.server-firstboot-complete

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/arbiter-server-firstboot
TimeoutStartSec=1800
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
