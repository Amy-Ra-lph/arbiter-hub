# Containerfile.arbiter-attestation — Decision Plane (bootc)
#
# Arbiter Hub API/UI/DB/MCP containers (Quadlet), EDA controller,
# enforcement-mcp. Holds only PUBLIC keys — no signing keys or CAs.
#
# Build (from repo root):
#   podman build -t quay.io/rhel-security/arbiter-attestation:latest \
#     -f deploy/bootc/Containerfile.arbiter-attestation .

FROM quay.io/fedora/fedora-bootc:44

RUN dnf install -y \
        freeipa-client \
        nginx \
        certmonger \
        python3-ansible-runner \
        python3-pip \
        cloud-init \
        qemu-guest-agent \
    && dnf clean all

# ansible-rulebook — not in Fedora 44 repos
RUN pip install ansible-rulebook ansible

# Quadlet container units + volumes + network
COPY deploy/quadlet/ /etc/containers/systemd/

# EDA rulebooks and plugins
COPY eda/ /opt/arbiter-eda/

# nginx TLS termination template
COPY deploy/bootc/nginx-arbiter-hub.conf.template /etc/nginx/conf.d/arbiter-hub.conf.template

# Firstboot provisioning
COPY deploy/bootc/hub-firstboot.sh /usr/local/sbin/arbiter-hub-firstboot
COPY deploy/bootc/hub-firstboot.service /etc/systemd/system/arbiter-hub-firstboot.service
COPY deploy/bootc/config.env.example /etc/arbiter-hub/config.env.example

# Directories for runtime config injected at firstboot
RUN mkdir -p /etc/arbiter/keylime /etc/arbiter/cosign /etc/arbiter-hub

# Lab access
RUN echo 'root:Secret123!' | chpasswd \
    && useradd -m -G wheel cloud-user \
    && echo 'cloud-user:Secret123!' | chpasswd \
    && echo '%wheel ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/wheel-nopasswd

RUN chmod 755 /usr/local/sbin/arbiter-hub-firstboot \
    && systemctl enable arbiter-hub-firstboot.service \
                        qemu-guest-agent.service
