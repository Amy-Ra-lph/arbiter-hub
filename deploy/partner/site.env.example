# Arbiter Hub — Design Partner Site Configuration
#
# Fill in your site-specific values. generate-configs.sh splits this into
# per-node config.env files for IPA, Hub, Signing, and Agent nodes.
#
# Required fields are marked (REQUIRED). Optional fields show defaults.
# Never commit this file with real passwords — use site.env.example as template.
#
# Usage:
#   cp site.env.example site.env
#   $EDITOR site.env
#   ./generate-configs.sh --site-env=site.env --output=configs/

# ── Shared ─────────────────────────────────────────────────────────
SITE_DOMAIN=                                # (REQUIRED) DNS domain, e.g. example.corp
SITE_REALM=                                 # (REQUIRED) Kerberos realm, e.g. EXAMPLE.CORP
ADMIN_PASSWORD=                             # (REQUIRED) IPA admin password
DS_PASSWORD=                                # (REQUIRED) Directory Server manager password
DNS_FORWARDER=                              # (REQUIRED) upstream DNS resolver IP

# ── IPA Node ───────────────────────────────────────────────────────
IPA_HOSTNAME=                               # (REQUIRED) FQDN, e.g. ipa.example.corp
IPA_IP=                                     # (optional) static IP if not DNS-resolvable
IPA_SETUP_DNS=yes                           # (optional) install IPA DNS server
IPA_NO_REVERSE=yes                          # (optional) skip reverse DNS zone

# ── Hub Node (Arbiter Attestation) ─────────────────────────────────
HUB_HOSTNAME=                               # (REQUIRED) FQDN, e.g. hub.example.corp
HUB_IP=                                     # (optional) static IP if not DNS-resolvable
DB_PASSWORD=                                # (optional) PostgreSQL password, auto-generated if empty
WEBHOOK_SECRET=                             # (optional) EDA webhook secret, auto-generated if empty
ARBITER_SERVICE_PASSWORD=                   # (optional) service auth fallback, auto-generated if empty
API_PORT=8400                               # (optional) Hub API port
MCP_PORT=8401                               # (optional) MCP server port
UI_PORT=8402                                # (optional) UI server port
EDA_PORT=5001                               # (optional) EDA webhook listener port

# ── Signing Node ───────────────────────────────────────────────────
SIGNING_HOSTNAME=                           # (REQUIRED) FQDN, e.g. signing.example.corp
SIGNING_IP=                                 # (optional) static IP if not DNS-resolvable
COSIGN_PASSWORD=                            # (optional) cosign keypair passphrase, auto-generated if empty
REGISTRY_PORT=5000                          # (optional) container registry port

# ── Agent Node(s) ──────────────────────────────────────────────────
AGENT_HOSTNAMES=                            # (REQUIRED) space-separated FQDNs, e.g. "agent1.example.corp agent2.example.corp"

# ── PQC Options ────────────────────────────────────────────────────
PQC_ENABLED=yes                             # (optional) enable post-quantum cryptography
PQC_ALGORITHM=ML-DSA-65                     # (optional) PQ signing algorithm
PQC_KEM=ML-KEM-768                          # (optional) PQ key encapsulation
KUIPA_ENROLL=yes                            # (optional) enroll nodes with kuipa
RHCS_CA_URL=                                # (REQUIRED) RHCS root CA URL, e.g. https://ca.example.corp:8443
RHCS_CA_CERT=                               # (optional) path to RHCS root CA cert PEM

# ── Deployment ─────────────────────────────────────────────────────
DEPLOY_TARGET=kvm                           # (optional) kvm | bare-metal | image-only
IMAGES_DIR=                                 # (optional) local image path for offline/air-gapped
SSH_PUBKEY=                                 # (optional) SSH public key to inject into all nodes
