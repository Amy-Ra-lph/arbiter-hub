[Unit]
Description=Arbiter Hub API Server
After=arbiter-hub-db.container
Requires=arbiter-hub-db.container
# At first boot this unit races firstboot for the podman secrets it mounts.
# Never let the start-rate limiter disable it before firstboot creates them.
StartLimitIntervalSec=0

[Container]
Image=quay.io/rhel-security/arbiter-hub-api:latest
ContainerName=arbiter-hub-api
Network=arbiter-hub.network
PublishPort=8400:8400
Volume=arbiter-hub-certs.volume:/etc/arbiter/certs:ro,Z
Volume=arbiter-hub-keylime.volume:/etc/arbiter/keylime:ro,Z
Secret=arbiter-hub-db-password,type=mount,target=arbiter_db_password
Secret=arbiter-hub-admin-password,type=mount,target=arbiter_local_admin_password
Environment=ARBITER_KEYLIME_VERIFIER_URL=
Environment=ARBITER_KEYLIME_CA_CERT=/etc/arbiter/keylime/ca.crt
Environment=ARBITER_KEYLIME_CLIENT_CERT=/etc/arbiter/keylime/client.crt
Environment=ARBITER_KEYLIME_CLIENT_KEY=/etc/arbiter/keylime/client.key
ReadOnly=true

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
