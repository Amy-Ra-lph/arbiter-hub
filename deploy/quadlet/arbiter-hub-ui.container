[Unit]
Description=Arbiter Hub UI (nginx + React SPA)
After=arbiter-hub-api.container

[Container]
Image=docker.io/library/nginx:alpine
ContainerName=arbiter-hub-ui
Network=arbiter-hub.network
PublishPort=8080:8080
PublishPort=8443:8443
Volume=./ui:/opt/app-root/src:ro
Volume=./deploy/nginx/nginx.conf:/etc/nginx/nginx.conf:ro
Volume=./deploy/nginx/certs:/etc/nginx/certs:ro
SecurityLabelDisable=true
ReadOnly=true

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=30

[Install]
WantedBy=default.target
