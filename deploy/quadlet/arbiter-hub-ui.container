[Unit]
Description=Arbiter Hub UI (nginx + React SPA)
After=arbiter-hub-api.container

[Container]
Image=localhost/arbiter-hub-ui:http-only
ContainerName=arbiter-hub-ui
Network=arbiter-hub.network
PublishPort=8080:8080
Volume=/opt/arbiter-hub/ui:/opt/app-root/src:ro,z
SecurityLabelDisable=true

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target default.target
