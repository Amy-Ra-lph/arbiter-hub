# Arbiter Hub demo credentials — copy to credentials.env and fill in
# Usage: source credentials.env && ansible-playbook -i inventory/arbiter-demo.yml rebuild.yaml \
#   -e vault_ipa_admin_password=$VAULT_IPA_ADMIN_PASSWORD \
#   -e vault_demo_user_password=$VAULT_DEMO_USER_PASSWORD \
#   -e vault_db_password=$VAULT_DB_PASSWORD \
#   -e arbiter_oidc_client_secret=$ARBITER_OIDC_CLIENT_SECRET

VAULT_IPA_ADMIN_PASSWORD=
VAULT_DEMO_USER_PASSWORD=
VAULT_DB_PASSWORD=
ARBITER_OIDC_CLIENT_SECRET=

# Optional: container registry auth (only if pulling from Quay)
VAULT_QUAY_ROBOT_USER=
VAULT_QUAY_ROBOT_TOKEN=

# Optional: registry.redhat.io (for PostgreSQL image)
VAULT_REGISTRY_USER=
VAULT_REGISTRY_TOKEN=
