---
version: "2.0"
backingStore: vault
vaultPolicies:
  - name: arbiter-secret-policy
    namespace: arbiter-system

secrets:
  - name: ipa-credentials
    vaultPrefixes:
      - global
    fields:
      - name: admin_password
        prompt: "IPA admin password"
      - name: dm_password
        prompt: "IPA Directory Manager password"

  - name: arbiter-db-credentials
    vaultPrefixes:
      - global
    fields:
      - name: db_password
        prompt: "Arbiter Hub PostgreSQL password"

  - name: webhook-secret
    vaultPrefixes:
      - global
    fields:
      - name: secret
        prompt: "EDA webhook secret"
        generate: true
        length: 32

  - name: keylime-tls
    vaultPrefixes:
      - global
    fields:
      - name: ca_cert
        path: keylime-ca.pem
      - name: server_cert
        path: keylime-server.pem
      - name: server_key
        path: keylime-server-key.pem

  - name: spire-bootstrap
    vaultPrefixes:
      - global
    fields:
      - name: trust_bundle
        prompt: "SPIRE server trust bundle (PEM)"
