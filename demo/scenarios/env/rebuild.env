# Arbiter Hub rebuild lab — Beaker J:1200306184
# Source this before running any demo script
#
# Copy this file to a local override and fill in your lab-specific values.
# DO NOT commit lab IPs or secrets to the repo.
export ARBITER_HUB_URL="https://${ARBITER_HUB_HOST:-hub.arbiter-rebuild.demo}:8400"
export ARBITER_IDP_URL="https://${ARBITER_IDM_HOST:-idm.arbiter-rebuild.demo}/idp"
export ARBITER_REALM="${ARBITER_REALM:-ARBITER-REBUILD.DEMO}"
export ARBITER_DOMAIN="${ARBITER_DOMAIN:-arbiter-rebuild.demo}"
export ARBITER_IDM_HOST="${ARBITER_IDM_HOST:-idm.arbiter-rebuild.demo}"
export ARBITER_HUB_HOST="${ARBITER_HUB_HOST:-hub.arbiter-rebuild.demo}"
export ARBITER_AGENT_HOST="${ARBITER_AGENT_HOST:-agent.arbiter-rebuild.demo}"
export ARBITER_CLIENT_SECRET="${ARBITER_CLIENT_SECRET:?Set ARBITER_CLIENT_SECRET before sourcing}"
export ARBITER_SSH_KEY="${ARBITER_SSH_KEY:-$HOME/.ssh/idm_ci_key}"
export ARBITER_ENFORCEMENT_MCP_URL="http://${ARBITER_HUB_HOST:-hub.arbiter-rebuild.demo}:8402"
export ARBITER_REGISTRY="${ARBITER_REGISTRY:-localhost:5000}"
export DEMO_PAUSE="${DEMO_PAUSE:-3}"
